---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventItem from '../components/EventItem.astro';
import { profile } from '../data/profile';
import { industry } from '../data/industry';
import { teaching } from '../data/teaching';
import { research } from '../data/research';
import { upcomingEvents } from '../data/events';

interface ContactLink {
  label: string;
  href: string;
  /** External web links open in a new tab; mailto links do not. */
  external: boolean;
}

const contactLinks: ContactLink[] = [
  profile.links.email && {
    label: 'Email',
    href: `mailto:${profile.links.email}`,
    external: false,
  },
  profile.links.linkedin && {
    label: 'LinkedIn',
    href: profile.links.linkedin,
    external: true,
  },
  profile.links.github && {
    label: 'GitHub',
    href: profile.links.github,
    external: true,
  },
].filter((link): link is ContactLink => Boolean(link));

const featuredCase = industry.home.featured;
const supportingCases = industry.home.supporting;
const currentCourses = teaching.current[0].courses;
const nextEvent = upcomingEvents[0];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.shortName,
  honorificSuffix: 'PhD',
  url: 'https://edbezci.github.io/',
  description: profile.seo.description,
  worksFor: {
    '@type': 'Organization',
    name: 'Aethernix',
    url: 'https://aethernix.com',
  },
  affiliation: [
    { '@type': 'Organization', name: 'Universität für Weiterbildung Krems' },
    {
      '@type': 'Organization',
      name: 'Global and National Security Institute, University of South Florida',
    },
    { '@type': 'Organization', name: 'Royal Historical Society' },
  ],
  sameAs: [
    profile.links.linkedin,
    profile.links.github,
    profile.links.orcid,
    profile.links.googleScholar,
  ].filter((url): url is string => Boolean(url)),
};
---

<BaseLayout>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(personJsonLd)}
  />
  <Hero />

  <section class="section section--light" id="profile" aria-labelledby="profile-heading">
    <div class="container">
      <SectionHeading
        id="profile-heading"
        label={profile.homeProfile.label}
        heading={profile.homeProfile.heading}
      />
      <div class="prose">
        {profile.homeProfile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <blockquote class="pullquote">
        <p>&ldquo;{profile.homeProfile.pullQuote}&rdquo;</p>
      </blockquote>
      <p class="section-cta">
        <a href={profile.homeProfile.cta.href}>
          {profile.homeProfile.cta.label}<span aria-hidden="true"> &rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section section--slate" id="industry" aria-labelledby="industry-heading">
    <div class="container">
      <SectionHeading
        id="industry-heading"
        label={industry.home.label}
        heading={industry.home.heading}
      />
      <div class="prose">
        <p>{industry.home.intro}</p>
      </div>
      <article class="case-feature">
        <p class="kicker">Featured case</p>
        <h3 class="case-feature__title">{featuredCase.title}</h3>
        {featuredCase.contextLine && (
          <p class="case-feature__context">{featuredCase.contextLine}</p>
        )}
        {featuredCase.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {featuredCase.link && (
          <p class="case-feature__link">
            <a href={featuredCase.link.href}>
              {featuredCase.link.label}<span aria-hidden="true"> &rarr;</span>
            </a>
          </p>
        )}
      </article>
      <div class="columns">
        {
          supportingCases.map((item) => (
            <div>
              <h3>
                {item.link ? (
                  <a href={item.link.href} target="_blank" rel="noopener noreferrer">
                    {item.title}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ))
        }
      </div>

      <div class="aethernix-callout">
        <p class="kicker">Current consultancy</p>
        <h3 class="aethernix-callout__title">Aethernix — my boutique AI consultancy</h3>
        <p>
          Through <a href="https://aethernix.com/" target="_blank" rel="noopener noreferrer">Aethernix</a>,
          I offer specialist advice, hands-on development and fractional technical leadership for
          organisations working on fraud, risk and private knowledge systems.
        </p>
        <p>Engagements connect model development with operational workflows, governance and human oversight.</p>
        <p class="aethernix-callout__link">
          <a href="https://aethernix.com/" target="_blank" rel="noopener noreferrer">
            Explore Aethernix<span aria-hidden="true"> &rarr;</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      </div>

      <p class="section-cta">
        <a href={industry.home.cta.href}>
          {industry.home.cta.label}<span aria-hidden="true"> &rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section section--light" id="teaching" aria-labelledby="teaching-heading">
    <div class="container">
      <SectionHeading
        id="teaching-heading"
        label={teaching.home.label}
        heading={teaching.home.heading}
      />
      <div class="prose">
        {teaching.home.intro.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="home-courses">
        {
          currentCourses.map((course) => (
            <div class="home-course">
              <h3>{course.title}</h3>
              <p>{course.homeNote}</p>
              {course.repositoryUrl && (
                <p class="home-course__link">
                  <a href={course.repositoryUrl} target="_blank" rel="noopener noreferrer">
                    Course materials
                    <span class="visually-hidden"> (opens in a new tab)</span>
                    <span aria-hidden="true"> &rarr;</span>
                  </a>
                </p>
              )}
            </div>
          ))
        }
      </div>
      <p class="section-cta">
        <a href="/teaching-speaking/">
          Teaching history and materials<span aria-hidden="true"> &rarr;</span>
        </a>
      </p>
      {nextEvent && (
        <div class="home-event">
          <EventItem event={nextEvent} />
          <p class="home-event__note">{teaching.home.attendNote}</p>
        </div>
      )}
      <p class="section-cta">
        <a href="/speaking/">
          Speaking and events<span aria-hidden="true"> &rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section section--light" id="research" aria-labelledby="research-heading">
    <div class="container">
      <SectionHeading
        id="research-heading"
        label={research.home.label}
        heading={research.home.heading}
      />
      <div class="prose">
        {
          research.home.paragraphs.map((paragraph) => (
            <p>
              {paragraph.map((segment) =>
                typeof segment === 'string' ? (
                  segment
                ) : (
                  <cite>{segment.cite}</cite>
                ),
              )}
            </p>
          ))
        }
      </div>
      <p class="section-cta">
        {
          research.home.ctas.map((cta) => (
            <a href={cta.href}>
              {cta.label}<span aria-hidden="true"> &rarr;</span>
            </a>
          ))
        }
      </p>
    </div>
  </section>

  <section class="section section--dark" id="contact" aria-labelledby="contact-heading">
    <div class="container">
      <h2 class="contact__heading" id="contact-heading">{profile.homeContact.heading}</h2>
      <p class="contact__copy">{profile.homeContact.copy}</p>
      {
        contactLinks.length > 0 && (
          <ul class="contact__links">
            {contactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {link.external && (
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="section-cta">
        <a href={profile.homeContact.cta.href}>
          {profile.homeContact.cta.label}<span aria-hidden="true"> &rarr;</span>
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .case-feature {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--accent);
  }

  .case-feature__title {
    font-size: clamp(1.5rem, 2.8vw, 1.9rem);
    color: var(--text);
    margin: 0 0 0.75rem;
  }

  .case-feature__context {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .case-feature p:not(.kicker) {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .case-feature p:last-child {
    margin-bottom: 0;
  }

  .case-feature__link {
    margin: 1.25rem 0 0;
    font-weight: 600;
  }

  .aethernix-callout {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent);
    max-width: var(--measure);
  }

  .aethernix-callout__title {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--text);
    margin: 0 0 1rem;
  }

  .aethernix-callout p {
    color: var(--text-muted);
  }

  .aethernix-callout p:last-of-type {
    margin-bottom: 0;
  }

  .aethernix-callout__link {
    margin: 1.25rem 0 0;
    font-weight: 600;
  }

  .columns h3 a {
    color: inherit;
    text-decoration-color: var(--accent);
  }

  .columns h3 a:hover,
  .columns h3 a:focus-visible {
    color: var(--accent);
  }

  .home-courses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .home-course {
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }

  .home-course h3 {
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .home-course p {
    color: var(--text-muted);
    font-size: 0.98rem;
    margin-bottom: 0;
  }

  .home-course__link {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .home-event {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .home-event__note {
    margin: 1rem 0 0;
    color: var(--text-muted);
  }

  .contact__heading {
    max-width: 24ch;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: -0.01em;
  }

  .contact__copy {
    max-width: var(--measure);
    margin: 1.5rem 0 0;
    color: var(--text-muted);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .contact__links a {
    font-weight: 600;
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .contact__links a:hover,
  .contact__links a:focus-visible {
    transform: translateY(-1px);
  }
</style>
