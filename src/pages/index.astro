---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeachingCard from '../components/TeachingCard.astro';
import { profile } from '../data/profile';

interface ContactLink {
  label: string;
  href: string;
  /** External web links open in a new tab; mailto links do not. */
  external: boolean;
}

const contactLinks: ContactLink[] = [
  profile.links.email && {
    label: 'Email',
    href: `mailto:${profile.links.email}`,
    external: false,
  },
  profile.links.linkedin && {
    label: 'LinkedIn',
    href: profile.links.linkedin,
    external: true,
  },
  profile.links.github && {
    label: 'GitHub',
    href: profile.links.github,
    external: true,
  },
  profile.links.orcid && {
    label: 'ORCID',
    href: profile.links.orcid,
    external: true,
  },
  profile.links.resume && {
    label: 'Résumé',
    href: profile.links.resume,
    external: true,
  },
].filter((link): link is ContactLink => Boolean(link));
---

<BaseLayout>
  <Hero />

  <section class="section section--light" id="profile" aria-labelledby="profile-heading">
    <div class="container">
      <SectionHeading
        id="profile-heading"
        label={profile.profile.label}
        heading={profile.profile.heading}
      />
      <div class="prose">
        {profile.profile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="columns">
        {
          profile.profile.areas.map((area) => (
            <div>
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--slate" id="industry" aria-labelledby="industry-heading">
    <div class="container">
      <SectionHeading
        id="industry-heading"
        label={profile.industry.label}
        heading={profile.industry.heading}
      />
      <div class="prose">
        {profile.industry.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--light" id="teaching" aria-labelledby="teaching-heading">
    <div class="container">
      <SectionHeading
        id="teaching-heading"
        label={profile.teaching.label}
        heading={profile.teaching.heading}
      />
      <div class="prose">
        <p>{profile.teaching.intro}</p>
      </div>
      <div class="teaching-grid">
        {profile.teaching.entries.map((entry) => <TeachingCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section section--light" id="research" aria-labelledby="research-heading">
    <div class="container">
      <SectionHeading
        id="research-heading"
        label={profile.research.label}
        heading={profile.research.heading}
      />
      <div class="prose">
        {
          profile.research.paragraphs.map((paragraph) => (
            <p>
              {paragraph.map((segment) =>
                typeof segment === 'string' ? (
                  segment
                ) : (
                  <cite>{segment.cite}</cite>
                ),
              )}
            </p>
          ))
        }
      </div>
      {
        profile.publications.enabled && (
          <p class="research__more">
            <a href={profile.publications.route}>
              View all publications<span aria-hidden="true"> &rarr;</span>
            </a>
          </p>
        )
      }
    </div>
  </section>

  <section class="section section--dark" id="contact" aria-labelledby="contact-heading">
    <div class="container">
      <h2 class="contact__heading" id="contact-heading">{profile.contact.heading}</h2>
      <p class="contact__copy">{profile.contact.copy}</p>
      {
        contactLinks.length > 0 && (
          <ul class="contact__links">
            {contactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {link.external && (
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .teaching-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .research__more {
    margin: 0.5rem 0 0;
  }

  .research__more a {
    font-weight: 600;
  }

  .contact__heading {
    max-width: 24ch;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: -0.01em;
  }

  .contact__copy {
    max-width: var(--measure);
    margin-top: 1.5rem;
    color: var(--text-muted);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .contact__links a {
    font-weight: 600;
  }
</style>
