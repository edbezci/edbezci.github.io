---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventItem from '../components/EventItem.astro';
import { teaching } from '../data/teaching';
import { upcomingEvents, featuredPastEvents } from '../data/events';

const { page, seo } = teaching;
---

<BaseLayout title={seo.title} description={seo.description}>
  <PageHeader label={page.label} heading={page.heading} intro={page.intro.split('\n\n').join(' ')} />

  <section class="section section--light page-section" aria-labelledby="current-teaching-heading">
    <div class="container">
      <h2 class="page-section__heading" id="current-teaching-heading">Current teaching</h2>
      {
        teaching.current.map((institution) => (
          <div class="institution">
            <h3 class="institution__name">{institution.institution}</h3>
            <p class="institution__role">
              {institution.role}, {institution.period}
            </p>
            {institution.description && (
              <p class="institution__description">{institution.description}</p>
            )}
            <ul class="course-list" role="list">
              {institution.courses.map((course) => (
                <li>
                  <p class="course-list__title">{course.title}</p>
                  <p class="course-list__detail">{course.note}</p>
                  {course.repositoryUrl && (
                    <p class="course-list__link">
                      <a
                        href={course.repositoryUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Course materials
                        <span class="visually-hidden">
                          : {course.title} (opens in a new tab)
                        </span>
                        <span aria-hidden="true"> &rarr;</span>
                      </a>
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--light page-section" aria-labelledby="previous-teaching-heading">
    <div class="container">
      <h2 class="page-section__heading" id="previous-teaching-heading">
        Previous university teaching
      </h2>
      {
        teaching.previous.map((institution) => (
          <div class="institution">
            <h3 class="institution__name">{institution.institution}</h3>
            <ul class="course-list" role="list">
              {institution.courses.map((course) => (
                <li>
                  <p class="course-list__title">{course.title}</p>
                  <p class="course-list__detail">
                    {course.kind}, {course.period}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--light page-section" aria-labelledby="professional-education-heading">
    <div class="container">
      <h2 class="page-section__heading" id="professional-education-heading">
        Professional education
      </h2>
      {
        teaching.professional.map((institution) => (
          <div class="institution">
            <h3 class="institution__name">{institution.institution}</h3>
            <ul class="course-list" role="list">
              {institution.courses.map((course) => (
                <li>
                  <p class="course-list__title">{course.title}</p>
                  <p class="course-list__detail">
                    {course.kind}, {course.period}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--light page-section" aria-labelledby="speaking-heading">
    <div class="container">
      <h2 class="page-section__heading" id="speaking-heading">Speaking and events</h2>

      {upcomingEvents.length > 0 && (
        <>
          <h3 class="page-section__subheading">Upcoming</h3>
          <div class="event-stack">
            {upcomingEvents.map((event) => <EventItem event={event} />)}
          </div>
        </>
      )}

      {featuredPastEvents.length > 0 && (
        <>
          <h3 class="page-section__subheading">Selected recent appearances</h3>
          <div class="event-stack">
            {featuredPastEvents.map((event) => <EventItem event={event} />)}
          </div>
        </>
      )}

      <p class="section-cta">
        <a href="/speaking/">
          Speaking archive<span aria-hidden="true"> &rarr;</span>
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .institution {
    margin-top: 2rem;
  }

  .institution:first-of-type {
    margin-top: 0.5rem;
  }

  .institution__name {
    font-size: 1.25rem;
    color: var(--text);
  }

  .institution__role {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .institution__description {
    margin: 0.9rem 0 0;
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .course-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    max-width: 46rem;
  }

  .course-list li {
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }

  .course-list__title {
    margin: 0;
    font-weight: 600;
    color: var(--text);
  }

  .course-list__detail {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
  }

  .course-list__link {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .event-stack {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
  }
</style>
