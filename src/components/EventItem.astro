---
import type { SpeakingEvent } from '../data/events';

interface Props {
  event: SpeakingEvent;
}

const { event } = Astro.props;

const locationParts = [
  event.venue,
  event.city && event.country ? `${event.city}, ${event.country}` : event.city || event.country,
].filter(Boolean);

const location = locationParts.join(' · ');
---

<article class="event">
  <h3 class="event__name">
    {
      event.eventUrl ? (
        <a href={event.eventUrl} target="_blank" rel="noopener noreferrer">
          {event.eventName}
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      ) : (
        event.eventName
      )
    }
  </h3>
  <p class="event__meta">
    <span class="event__dates">{event.displayDate}</span>
    {location && <span class="event__location"> · {location}</span>}
  </p>
  <p class="event__role">{event.role}</p>
  {event.theme && <p class="event__theme">{event.theme}</p>}
  {
    event.contributionTitle && (
      <p class="event__contribution">
        {event.contributionType === 'panel'
          ? `Panel: ${event.contributionTitle}`
          : event.contributionType === 'paper'
            ? `Presentation: ${event.contributionTitle}`
            : event.contributionTitle}
      </p>
    )
  }
  {event.hostInstitution && <p class="event__host">Host: {event.hostInstitution}</p>}
  {
    event.organisers && event.organisers.length > 0 && (
      <p class="event__organisers">
        {event.organisers.length > 1 ? 'Organisers' : 'Organiser'}: {event.organisers.join(' and ')}
      </p>
    )
  }
  {
    event.collaborators && event.collaborators.length > 0 && (
      <p class="event__collaborators">
        In collaboration with: {event.collaborators.join(' and ')}
      </p>
    )
  }
  {
    event.programmeUrl && (
      <p class="event__link">
        <a href={event.programmeUrl} target="_blank" rel="noopener noreferrer">
          Official programme
          <span class="visually-hidden"> (opens in a new tab)</span>
          <span aria-hidden="true"> &#8599;</span>
        </a>
      </p>
    )
  }
</article>

<style>
  .event {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background-color: #faf8f2;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent);
    max-width: 40rem;
  }

  .event__name {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--text);
  }

  .event__name a {
    color: inherit;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .event__name a:hover,
  .event__name a:focus-visible {
    color: var(--accent);
  }

  .event__meta {
    margin: 0.5rem 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .event__dates {
    font-variant-numeric: tabular-nums;
  }

  .event__role {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .event__theme {
    margin: 0.6rem 0 0;
    font-style: italic;
    color: var(--text);
  }

  .event__contribution {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
  }

  .event__host,
  .event__organisers,
  .event__collaborators {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .event__link {
    margin: 0.9rem 0 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
