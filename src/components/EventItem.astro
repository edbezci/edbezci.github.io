---
import { eventLabel, type SpeakingEvent } from '../data/events';

interface Props {
  event: SpeakingEvent;
}

const { event } = Astro.props;
---

<article class="event">
  <p class="event__kicker">{eventLabel(event)}</p>
  <p class="event__dates">{event.dates}</p>
  <h3 class="event__name">
    {
      event.url ? (
        <a href={event.url} target="_blank" rel="noopener noreferrer">
          {event.event}
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      ) : (
        event.event
      )
    }
  </h3>
  {event.theme && <p class="event__theme"><cite>{event.theme}</cite></p>}
  {event.topic && <p class="event__topic">{event.topic}</p>}
  {event.location && <p class="event__location">{event.location}</p>}
  {
    event.presentationTitle && (
      <p class="event__presentation">‘{event.presentationTitle}’</p>
    )
  }
</article>

<style>
  .event {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background-color: #faf8f2;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent);
    max-width: 40rem;
  }

  .event__kicker {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .event__dates {
    margin: 0.6rem 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .event__name {
    margin-top: 0.4rem;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--text);
  }

  .event__name a {
    color: inherit;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .event__name a:hover,
  .event__name a:focus-visible {
    color: var(--accent);
  }

  .event__theme {
    margin: 0.5rem 0 0;
    color: var(--text);
  }

  .event__topic {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
  }

  .event__location {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .event__presentation {
    margin: 0.5rem 0 0;
    color: var(--text);
  }
</style>
