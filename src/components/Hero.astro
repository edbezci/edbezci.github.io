---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import portrait from '../assets/egemen-photo-2026.png';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">
    <div class="hero__content hero-entrance">
      <h1 class="hero__name" id="hero-heading">{profile.name}</h1>
      <p class="hero__headline">{profile.headline}</p>
      <p class="hero__intro">{profile.heroIntro}</p>
      <div class="hero__actions">
        <a class="button" href={profile.heroAction.href}>{profile.heroAction.label}</a>
        {
          profile.links.resume && (
            <a class="button button--ghost" href={profile.links.resume}>
              View résumé
            </a>
          )
        }
      </div>
      <p class="hero__positioning">{profile.positioningLine.join(' · ')}</p>
    </div>
    <div class="hero__portrait hero-entrance">
      <Image
        src={portrait}
        alt="Portrait of Egemen Bezci"
        width={560}
        height={700}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--navy);
    color: var(--text);
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 9vw, 7rem);
  }

  .hero__inner {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .hero__content {
    flex: 1 1 62%;
    min-width: 0;
  }

  .hero__portrait {
    flex: 0 1 38%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--accent);
    overflow: hidden;
    align-self: center;
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 25%;
  }

  .hero__name {
    font-size: clamp(2.6rem, 6vw, 4.25rem);
    letter-spacing: -0.01em;
  }

  .hero__headline {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 600;
    color: var(--accent);
    margin: 0.9rem 0 0;
  }

  .hero__intro {
    max-width: 37rem;
    font-size: 1.12rem;
    color: var(--text);
    margin: 1.75rem 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--accent);
    border-radius: 2px;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .button:hover {
    background-color: var(--accent);
    color: var(--navy);
  }

  .button--ghost {
    border-color: var(--rule);
    color: var(--text-muted);
  }

  .button--ghost:hover {
    background-color: transparent;
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero__positioning {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.92rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .hero-entrance {
    will-change: transform, opacity;
  }

  .button {
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 200ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
  }

  .hero__portrait img {
    transition: transform 300ms ease;
  }

  .hero__portrait:hover img {
    transform: scale(1.01);
  }

  @media (max-width: 48rem) {
    .hero__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__portrait {
      align-self: center;
      max-width: 16rem;
      margin-top: 2.5rem;
    }
  }
</style>
