---
interface Props {
  id: string;
  label: string;
  heading: string;
}

const { id, label, heading } = Astro.props;
---

<div class="section-heading">
  <p class="section-heading__label">{label}</p>
  <h2 class="section-heading__heading" id={id}>{heading}</h2>
</div>

<style>
  .section-heading {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-heading__label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1.1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .section-heading__label::before {
    content: '';
    width: 2rem;
    height: 1px;
    background-color: var(--accent);
  }

  .section-heading__heading {
    max-width: 26ch;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: -0.01em;
    color: var(--text);
  }
</style>
