---
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
}

const { publication: p } = Astro.props;

const MONTHS = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];

/** '2016-09-16' -> '16 September 2016' */
const formatDate = (iso: string): string => {
  const [year, month, day] = iso.split('-').map(Number);
  return `${day} ${MONTHS[month - 1]} ${year}`;
};

const venue = p.venue ?? p.containerTitle;
const details: string[] = [];
if (p.volume) details.push(`vol. ${p.volume}`);
if (p.issue) details.push(`no. ${p.issue}`);
if (p.pages) details.push(`pp. ${p.pages}`);

/**
 * Venue line built as ordered parts so no stray whitespace is
 * introduced between text, <cite> and <time> elements.
 */
type VenuePart = string | { cite: string } | { time: string; label: string };

const venueParts: VenuePart[] = [];
if (p.category === 'thesis') {
  venueParts.push(`${p.note ? `${p.note}, ` : ''}${p.institution ?? ''}`);
} else {
  if (p.category === 'book-chapter') venueParts.push('In ');
  if (p.note) venueParts.push(`${p.note}, `);
  if (venue) venueParts.push({ cite: venue });
  if (details.length > 0) venueParts.push(`, ${details.join(', ')}`);
  if (p.publisher) {
    venueParts.push(
      `${venue || details.length > 0 ? '. ' : ''}${p.publisher}`,
    );
  }
}
if (p.publicationDate) {
  venueParts.push(', ');
  venueParts.push({
    time: p.publicationDate,
    label: formatDate(p.publicationDate),
  });
}
if (p.language === 'Turkish') venueParts.push(' · In Turkish');
if (p.isbn) venueParts.push(` · ISBN ${p.isbn}`);

const doiUrl = p.doi ? `https://doi.org/${p.doi}` : undefined;

interface EntryLink {
  label: string;
  href: string;
}

const urlLabel =
  p.category === 'book' || p.category === 'book-chapter'
    ? 'Publisher page'
    : p.category === 'thesis'
      ? 'Repository record'
      : 'View publication';

const links: EntryLink[] = [
  doiUrl && { label: 'DOI', href: doiUrl },
  p.url && p.url !== doiUrl && { label: urlLabel, href: p.url },
  p.openAccessUrl && { label: 'Open access', href: p.openAccessUrl },
].filter((link): link is EntryLink => Boolean(link));
---

<article class:list={['pub', { 'pub--featured': p.featured }]}>
  <p class="pub__year">
    <time datetime={p.publicationDate ?? String(p.year)}>{p.year}</time>
  </p>
  <div class="pub__body">
    <h3 class="pub__title">
      {p.title}{p.subtitle && <span class="pub__subtitle">: {p.subtitle}</span>}
    </h3>
    <p class="pub__authors">{p.authors.join(', ')}</p>
    <p class="pub__venue">
      {
        venueParts.map((part) =>
          typeof part === 'string' ? (
            part
          ) : 'cite' in part ? (
            <cite>{part.cite}</cite>
          ) : (
            <time datetime={part.time}>{part.label}</time>
          ),
        )
      }
    </p>
    {p.description && <p class="pub__description">{p.description}</p>}
    {
      p.linkStatus === 'legacy' && links.length === 0 && (
        <p class="pub__legacy">Original link no longer available.</p>
      )
    }
    {
      links.length > 0 && (
        <p class="pub__links">
          {links.map((link) => (
            <a href={link.href}>
              {link.label}
              <span aria-hidden="true">&#8599;</span>
              <span class="visually-hidden"> (external link)</span>
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.5rem 1.75rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }

  .pub__year {
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .pub__body {
    min-width: 0;
  }

  .pub__title {
    font-size: 1.18rem;
    line-height: 1.3;
    color: var(--text);
    overflow-wrap: break-word;
  }

  .pub--featured .pub__title {
    font-size: clamp(1.4rem, 2.6vw, 1.7rem);
  }

  .pub__subtitle {
    font-weight: 400;
  }

  .pub__authors {
    margin: 0.45rem 0 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .pub__venue {
    margin: 0.4rem 0 0;
    font-size: 0.98rem;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .pub__description {
    margin: 0.9rem 0 0;
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .pub__legacy {
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .pub__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .pub__links a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 40rem) {
    .pub {
      grid-template-columns: 1fr;
    }

    .pub__year {
      margin: 0;
    }
  }
</style>
